# Copy to .env for local development. Never commit real secrets.
# Production: set these in Render (API) and Vercel (web), not in git.

# --- Shared / API (apps/api, packages/database) ---
# Local value matches docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev
PORT=8000
BASE_URL=http://localhost:8000
NODE_ENV=development
LOGGER_LEVEL=debug

# --- Web (apps/web) ---
# Server-only. Next.js rewrites /trpc here and SSR tRPC uses this URL.
# Browser still calls same-origin /trpc. Do not set NEXT_PUBLIC_API_URL.
API_URL=http://localhost:8000

# Optional. Unused by the current client; leave unset in production.
# NEXT_PUBLIC_API_URL=

# Optional. Skip t3 env validation (CI / Docker).
# SKIP_ENV_VALIDATION=1

# --- Optional Google OAuth (packages/services) ---
# Discovery only today; Watchtower does not require sign-in.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Background browser push (API only) ---
# Generate local keys once: node packages/services/alerts/generate-keys.cjs
# In production set private values in Render secret settings, never NEXT_PUBLIC_.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://your-site.example
# CRON_SECRET=
# The scheduler also needs API_URL and the same CRON_SECRET.
